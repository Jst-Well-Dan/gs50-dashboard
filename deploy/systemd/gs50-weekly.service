[Unit]
Description=GS50 A 股共识周刷（官方端点 + 56 位 token，重出最近一期并 push）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/gs50-dashboard
Environment=HOME=/home/deploy
Environment=TZ=Asia/Shanghai
ExecStart=/bin/bash /opt/gs50-dashboard/deploy/run_weekly.sh
# 41 家 × 1 次/分钟 ≈ 41 分钟，官方端点会重试，留足 2 小时
TimeoutStartSec=7200
Nice=10
CPUQuota=150%
MemoryMax=2500M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gs50-weekly

[Install]
WantedBy=multi-user.target
